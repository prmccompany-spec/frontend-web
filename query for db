CREATE TABLE pending_payments (
  id          INT AUTO_INCREMENT PRIMARY KEY,
  member_id   INT           NOT NULL,
  title       VARCHAR(300)  NOT NULL,
  amount      DECIMAL(10,2) NOT NULL,
  due_date    DATE          NULL,
  notes       TEXT          NULL,
  status      ENUM('pending','paid') NOT NULL DEFAULT 'pending',
  created_at  DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at  DATETIME      NULL,
  CONSTRAINT fk_pending_payments_member
    FOREIGN KEY (member_id) REFERENCES members(id) ON DELETE CASCADE
);

CREATE TABLE rental_products (
  id            INT AUTO_INCREMENT PRIMARY KEY,
  name          VARCHAR(300)  NOT NULL,
  description   TEXT          NULL,
  per_day_rate  DECIMAL(10,2) NULL,
  per_hour_rate DECIMAL(10,2) NULL,
  is_active     TINYINT(1)    NOT NULL DEFAULT 1,
  created_at    DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE rentals (
  id            INT AUTO_INCREMENT PRIMARY KEY,
  product_id    INT           NOT NULL,
  member_id     INT           NOT NULL,
  rate_type     ENUM('day','hour') NOT NULL,
  rate_amount   DECIMAL(10,2) NOT NULL,
  start_date    DATETIME      NOT NULL,
  end_date      DATETIME      NOT NULL,
  amount        DECIMAL(10,2) NOT NULL,
  payment_type  ENUM('cash','qr') NOT NULL DEFAULT 'cash',
  collected_by  INT           NULL,
  status        ENUM('active','returned','cancelled') NOT NULL DEFAULT 'active',
  notes         TEXT          NULL,
  returned_at   DATETIME      NULL,
  created_at    DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at    DATETIME      NULL,
  CONSTRAINT fk_rentals_product
    FOREIGN KEY (product_id) REFERENCES rental_products(id),
  CONSTRAINT fk_rentals_member
    FOREIGN KEY (member_id) REFERENCES members(id) ON DELETE CASCADE,
  CONSTRAINT fk_rentals_collected_by
    FOREIGN KEY (collected_by) REFERENCES members(id)
);